# Simkuliah Presence Monitor — backend environment variables.
# Copy this file to `.env` and fill in the real values before running
# `docker compose up`. Variables are read by the backend via `env_file` in
# docker-compose.yml.

# Simkuliah gateway credentials
SIMKULIAH_NPM=your_npm_here
SIMKULIAH_PASSWORD=your_password_here

# ntfy.sh push notification topic
NTFY_TOPIC=your_ntfy_topic_here

# Secret key used to sign ntfy action tokens
ACTION_SECRET_KEY=your_action_secret_key_here

# Supabase Managed Database
# Modern API keys (recommended, sb_secret_... / sb_publishable_...)
# Legacy keys (anon / service_role) will be retired in early 2027.
SUPABASE_URL=https://ftznonanlbshweysliar.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
# Legacy fallback (optional):
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Backend API base URL (defaults to the local container if unset)
SIMKULIAH_API_BASE_URL=http://localhost:8000
