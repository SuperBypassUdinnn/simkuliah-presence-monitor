# Flutter Client Environment Configuration
# Copy this file to `client/.env` and supply your project values.
SUPABASE_URL=https://ftznonanlbshweysliar.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here

# Firebase Cloud Messaging (Android push). Copy the values from
# google-services.json (Firebase Console -> Project settings -> Your apps).
# Leave empty to build without push (desktop builds ignore these).
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# Backend origin for device token registration (FCM). Empty = push disabled.
SIMKULIAH_API_BASE_URL=
