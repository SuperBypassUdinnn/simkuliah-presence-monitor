# Simkuliah backend environment configuration.
#
# Local:  copy this file to `backend/.env` (or the repository root) and fill in
#         the values. The file is git-ignored and docker-ignored.
# Render: paste the filled contents into ONE Secret File named `.env`
#         (Dashboard -> simkuliah-backend -> Environment -> Secret Files).
#         It is mounted at /etc/secrets/.env and auto-detected at startup.
#
# Priority: real environment variables > ENV_FILE > /etc/secrets/*.env >
# backend/.env > ./.env (relative to the working directory).

# --- Simkuliah credentials --------------------------------------------------
SIMKULIAH_NPM=your_student_npm
SIMKULIAH_PASSWORD=your_simkuliah_password

# --- Supabase (managed database) --------------------------------------------
# Modern API key (sb_secret_...). The legacy SUPABASE_SERVICE_ROLE_KEY is also
# accepted for compatibility and retires early 2027.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# --- Push notification relay (ntfy.sh) --------------------------------------
# Use a long, unguessable topic name; anyone who knows it can read the pushes.
NTFY_TOPIC=your-private-topic-name
NTFY_BASE_URL=https://ntfy.sh

# --- Signed action buttons --------------------------------------------------
# HMAC secret for ntfy action-button tokens. Use a long random string.
ACTION_SECRET_KEY=change-me-to-a-long-random-string

# --- Adaptive polling intervals (seconds, optional) -------------------------
POLL_ACTIVE_INTERVAL_SECONDS=60
POLL_PRE_CLASS_INTERVAL_SECONDS=120
POLL_IDLE_INTERVAL_SECONDS=7200
